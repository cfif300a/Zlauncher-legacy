{
  "name": "zlauncher",
  "version": "1.0.0",
  "description": "The Ultimate Minecraft Launcher - Ultra Smooth, Animated, Pirate & Custom Auth",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "vite",
    "electron:build": "vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run electron:build && electron-builder --win",
    "dist:dir": "npm run electron:build && electron-builder --win --dir",
    "dist:portable": "npm run electron:build && electron-builder --win portable",
    "dist:installer": "npm run electron:build && electron-builder --win nsis",
    "dist:linux": "npm run electron:build && electron-builder --linux tar.gz",
    "dist:linux:dir": "npm run electron:build && electron-builder --linux --dir",
    "start": "electron ."
  },
  "keywords": [
    "minecraft",
    "launcher",
    "pirate",
    "offline",
    "modrinth",
    "fabric"
  ],
  "author": "ZLauncher Team",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "canvas-confetti": "^1.9.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "skinview3d": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "three": "^0.186.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.zlauncher.app",
    "productName": "ZLauncher",
    "copyright": "Copyright © 2026 ZLauncher Team",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Game",
      "executableName": "zlauncher"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZLauncher"
    }
  }
}
